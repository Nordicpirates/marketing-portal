PORT=3000
AUTH_PASSWORD=your-shared-password-here
STATE_DIR=/app/state

# Gift offer /lp/aboard. One code per offer: the two base offers share the first,
# the BIG BOX has its own. They are separate Shopify BXGY rules. Set these to
# rotate the codes without a deploy; the defaults in lib/lp-aboard.ts are the
# codes live in Shopify today.
GIFT_CODE_BASE=KRAKEN-A7F2
GIFT_CODE_BIGBOX=FULLHOLD-B642

# Shared secret between the Cloudflare Worker in front of
# https://nordicpirates.com/gift-offer and this service. gate generates a value
# for it (it matches the *_SECRET pattern), so do NOT put a real value here.
#
# The Worker rewrites the public path onto this service's upstream path:
#   /gift-offer     -> /lp/aboard
#   /gift-offer/*   -> /lp/aboard/*
#
# The Worker must send it as the header:   x-lp-proxy-secret: <value>
# and forward the real visitor as:         x-visitor-ip, x-visitor-country
#
# The claim endpoint is Worker-only. Without a matching secret it answers 403 and
# stores nothing: there is no fallback to CF-Connecting-IP, X-Forwarded-For or
# CF-IPCountry, because at this origin those are set by whoever can reach it. Once
# the secret checks out, x-visitor-ip and x-visitor-country are the only source of
# the visitor's identity and country.
#
# REQUIRED IN PRODUCTION. Leave it unset and the service fails closed: nothing
# matches, so every claim is refused and no codes are issued at all. It says so at
# boot. The page and its assets stay public either way, so an unset secret shows a
# page whose form always fails rather than a page that hands out codes to anyone.
#
# Copy the generated value from Studio into the Worker secret before routing the
# public URL here.
LP_PROXY_SECRET=

# Shared secret between this service and the emailer that sends the gift-code
# email. Server to server only: it is never sent to a browser and never appears in
# the public /gift-offer page. gate generates a value for it (it matches the
# *_SECRET pattern), so do NOT put a real value here.
#
# The emailer sends it as the header:   x-lp-admin-secret: <value>
# and uses it on these two routes:
#   GET  /lp/aboard/signups            signups it has not emailed yet
#   POST /lp/aboard/signups/mark-sent  mark ids as emailed
#
# Different from LP_PROXY_SECRET on purpose: that one only proves a request came
# through the Cloudflare Worker, this one unlocks the stored email addresses.
#
# Leave it unset and the service fails closed: both routes answer 403 to everyone,
# so nobody can read the signup list. It says so at boot.
LP_ADMIN_SECRET=
